# Econnet · backend-api. Aquí solo nombres, nunca valores.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL="postgresql://econnet:econnet@localhost:5432/econnet"
DATABASE_URL_TEST="postgresql://econnet:econnet@localhost:5432/econnet_test"

# 32 caracteres o más. Firma los enlaces de baja y anonimiza las IP.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatorio también en desarrollo: firma las sesiones del panel y los
# enlaces de los correos. 32 caracteres o más. Solo las pruebas tienen relleno.
APP_SECRET=

# Frontend que puede llamar a esta API (allowlist separada por comas)
CORS_ORIGINS="http://localhost:5173"
SITIO_PUBLICO="http://localhost:5173"

# Correo: consola (no manda nada) | resend
CORREO_DRIVER=consola
RESEND_API_KEY=
CORREO_REMITENTE="Econnet <hola@econnet.cl>"
CORREO_RESPONDER_A="ventas@econnet.cl"
CORREO_TOPE_DIARIO=1

# Pagos: simulado | webpay | mercadopago
PASARELA=simulado
WEBPAY_CODIGO_COMERCIO=
WEBPAY_API_KEY=
WEBPAY_BASE="https://webpay3gint.transbank.cl"
MP_ACCESS_TOKEN=
# Obligatorio si PASARELA=mercadopago: sin él no se puede comprobar la firma
# del webhook y en producción el aviso se descarta.
MP_WEBHOOK_SECRET=
MP_SANDBOX=1
PAGO_TIMEOUT_MS=8000
PAGO_CADUCA_HORAS=48

# Despacho: vacío = «por confirmar», y entonces la tienda NO cobra ese pedido
# Región:precio o Región:precio:díasHábiles, separados por |
# Ej: "Metropolitana de Santiago:6990:2|Valparaíso:9990:3|*:12990"
# Vacío = la tienda NO cobra despacho: lo confirma después. Nunca inventa tarifa.
# --- Panel de inventario ---
# Vacío = no hay panel: /api/panel/* responde 503. El valor sale de
# «npm run clave -- "tu clave"». La clave en claro no se guarda en ningún sitio.
ADMIN_CLAVE_HASH=
ADMIN_SESION_HORAS=8
# Intentos de clave por IP y ventana. Bajo a propósito: aquí no hay clientes
# detrás de una IP compartida, hay una persona que sabe la suya.
LIMITE_ENTRADAS=10

ENVIO_TABLA=
ENVIO_GRATIS=0

# Carritos abandonados
CARRITO_DIAS=7
CARRITO_ESPERA_HORAS=4
CARRITO_MINIMO=150000

# Límites y trabajos
LIMITE_PETICIONES=30
LIMITE_VENTANA_MINUTOS=10
TRABAJO_PRESUPUESTO_MS=8000
TRABAJO_LOTE=50
CRON_SECRET=
CUPON_BIENVENIDA=BIENVENIDA10
WHATSAPP=
